# ---- Database (Turso / libSQL) -------------------------------------------
# Production: create a database at https://turso.tech and paste its URL + token.
TURSO_DATABASE_URL="libsql://your-db-name-xxxx.turso.io"
TURSO_AUTH_TOKEN="eyJ..."
# Local development: use a local SQLite file instead (in .env.development.local)
# TURSO_DATABASE_URL="file:./local.db"

# ---- Session --------------------------------------------------------------
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# ---- First admin account (used by `npm run db:seed`) ----------------------
SEED_ADMIN_EMAIL="owner@spiderlink.co.ke"
SEED_ADMIN_PASSWORD="ChangeMe-12345"
SEED_ADMIN_NAME="Owner"

# ---- Public site ----------------------------------------------------------
# On Vercel use the deployment URL (or the custom domain once attached).
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="254743498210"

# ---- Optional: Turnstile CAPTCHA on public forms --------------------------
# Reserved — not enforced in v1.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ---- Future integrations (not used in v1; see docs/API.md) ----------------
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""
# MPESA_CONSUMER_KEY=""
# MPESA_CONSUMER_SECRET=""
# MPESA_PASSKEY=""
# MPESA_SHORTCODE=""
# MPESA_CALLBACK_URL=""
# ISPLEDGER_SMS_API_KEY=""
# ISPLEDGER_SMS_SENDER_ID=""
